# ==============================================================================
# 🐕 Watchdog Configuration (.env)
# ==============================================================================
# Optional environment variables for configuring Watchdog TUI.
# Copy this file to .env or export these variables in your shell environment.

# Docker daemon connection URL or socket path
# Default: unix:///var/run/docker.sock (local Docker daemon)
# Remote example: tcp://192.168.1.100:2375
DOCKER_HOST=unix:///var/run/docker.sock

# Metrics polling interval in seconds
# Default: 2.0
WATCHDOG_INTERVAL=2.0

# Default number of log lines to tail when opening log viewer
# Default: 150
WATCHDOG_LOG_TAIL=150
