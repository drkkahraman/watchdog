/* Watchdog Modern Dark / Cyberpunk Theme */

Screen {
    background: #0f172a;
    color: #e2e8f0;
    layout: vertical;
}

/* Header & Stat Cards */
#header-container {
    height: auto;
    dock: top;
    background: #1e293b;
    border-bottom: solid #334155;
    padding: 0 1;
}

#brand-bar {
    height: 1;
    layout: horizontal;
    margin-top: 0;
    margin-bottom: 0;
}

#brand-title {
    text-style: bold;
    color: #38bdf8;
    width: 25;
}

#brand-docker-status {
    width: 1fr;
    text-align: right;
    color: #94a3b8;
}

#stats-grid {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 1fr 1fr 1fr 1fr 1fr;
    height: 3;
    margin: 0 0;
}

.stat-card {
    background: #0f172a;
    border: solid #334155;
    padding: 0 1;
    height: 3;
    content-align: center middle;
}

.stat-card-title {
    color: #64748b;
    text-style: bold;
    height: 1;
}

.stat-card-value {
    color: #38bdf8;
    text-style: bold;
    height: 1;
}

.stat-card-sub {
    color: #94a3b8;
    height: 1;
}

/* Main Body Layout */
#main-tabs {
    height: 1fr;
    background: #0f172a;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

/* Search Bar */
#search-container {
    height: 3;
    layout: horizontal;
    margin-bottom: 0;
    padding: 0 0;
}

#container-search-input {
    width: 1fr;
    background: #1e293b;
    border: solid #3b82f6;
    color: #f8fafc;
}

#filter-status-label {
    width: auto;
    padding: 0 1;
    color: #94a3b8;
    content-align: center middle;
}

/* Container Table */
#containers-table {
    height: 1fr;
    background: #0f172a;
    border: solid #1e293b;
}

DataTable > .datatable--header {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1e3a8a;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1e293b;
}

/* Service / Proxy Table */
#services-table {
    height: 1fr;
    background: #0f172a;
    border: solid #1e293b;
}

/* Quick Action Toolbar */
#container-action-bar {
    height: 3;
    background: #1e293b;
    border-top: solid #334155;
    padding: 0 1;
    align: left middle;
}

.action-btn {
    margin-right: 1;
    min-width: 14;
}

/* Quick Details Panel */
#quick-details-pane {
    height: 7;
    background: #0f172a;
    border-top: solid #334155;
    padding: 0 1;
    layout: horizontal;
}

#quick-details-left {
    width: 1fr;
}

#quick-details-right {
    width: 1fr;
}

.detail-line {
    color: #cbd5e1;
}

/* Footer / Action Bar */
#action-footer {
    dock: bottom;
    height: 1;
    background: #1e293b;
    color: #94a3b8;
    border-top: solid #334155;
    padding: 0 1;
}

/* Modal Windows */
ModalScreen {
    align: center middle;
    background: rgba(15, 23, 42, 0.85);
}

.modal-dialog {
    width: 85%;
    height: 85%;
    background: #1e293b;
    border: thick #38bdf8;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #38bdf8;
    border-bottom: solid #475569;
    padding-bottom: 0;
    margin-bottom: 1;
}

/* Log Modal */
#log-text-area {
    height: 1fr;
    background: #0f172a;
    border: solid #334155;
    color: #f1f5f9;
    padding: 0 1;
}

#log-controls {
    height: 3;
    layout: horizontal;
    margin-top: 1;
}

.log-btn {
    margin-right: 1;
}

/* Confirm Dialog */
.confirm-dialog {
    width: 55;
    height: 15;
    background: #1e293b;
    border: thick #ef4444;
    padding: 1 2;
    align: center middle;
}

#confirm-buttons {
    layout: horizontal;
    align: center middle;
    margin-top: 1;
    height: 3;
}

.btn-danger {
    background: #dc2626;
    color: #ffffff;
    margin-right: 2;
}

.btn-secondary {
    background: #475569;
    color: #ffffff;
}

/* Help Modal */
.help-dialog {
    width: 70;
    height: 22;
    background: #1e293b;
    border: thick #38bdf8;
    padding: 1 2;
}

#help-table {
    height: 1fr;
    background: #0f172a;
}
