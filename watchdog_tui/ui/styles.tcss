/* Watchdog - Ultra-Sleek Modern Terminal UI (Cyber/Nord Theme) */

Screen {
    background: #090d16;
    color: #e2e8f0;
    layout: vertical;
}

/* Header & Telemetry Cards */
#header-container {
    height: auto;
    dock: top;
    background: #0f172a;
    border-bottom: solid #1e293b;
    padding: 0 1;
}

#brand-bar {
    height: 1;
    layout: horizontal;
    margin: 0 0;
}

#brand-title {
    text-style: bold;
    color: #38bdf8;
    width: 28;
}

#brand-docker-status {
    width: 1fr;
    text-align: right;
    color: #94a3b8;
}

#stats-grid {
    layout: grid;
    grid-size: 5 1;
    grid-columns: 1fr 1fr 1fr 1fr 1fr;
    height: 3;
    margin-top: 0;
    margin-bottom: 0;
}

.stat-card {
    background: #0b1120;
    border: solid #1e293b;
    padding: 0 1;
    height: 3;
    content-align: center middle;
}

.stat-card:hover {
    border: solid #38bdf8;
}

.stat-card-title {
    color: #64748b;
    text-style: bold;
    height: 1;
}

.stat-card-value {
    color: #38bdf8;
    text-style: bold;
    height: 1;
}

.stat-card-sub {
    color: #94a3b8;
    height: 1;
}

/* Tabs & Main View */
#main-tabs {
    height: 1fr;
    background: #090d16;
}

TabbedContent {
    height: 1fr;
}

Tabs {
    background: #0f172a;
    border-bottom: solid #1e293b;
}

Tab {
    color: #94a3b8;
    padding: 0 2;
}

Tab:hover {
    color: #38bdf8;
}

Tab.-active {
    color: #38bdf8;
    text-style: bold;
    background: #0b1120;
    border-bottom: tall #38bdf8;
}

TabPane {
    padding: 0 1;
    height: 1fr;
}

/* Search Bar */
#search-container {
    height: 3;
    layout: horizontal;
    margin-bottom: 0;
    padding: 0 0;
}

#container-search-input, #service-search-input, #log-search-input {
    width: 1fr;
    background: #0f172a;
    border: solid #1e293b;
    color: #f8fafc;
    padding: 0 1;
}

#container-search-input:focus, #service-search-input:focus, #log-search-input:focus {
    border: solid #38bdf8;
}

#filter-status-label, #service-status-label {
    width: auto;
    padding: 0 1;
    color: #94a3b8;
    content-align: center middle;
    text-style: bold;
}

/* DataTables */
#containers-table, #services-table {
    height: 1fr;
    background: #0b1120;
    border: solid #1e293b;
}

DataTable > .datatable--header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
    border-bottom: solid #1e293b;
}

DataTable > .datatable--cursor {
    background: #1e3a8a;
    color: #ffffff;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #1e293b;
}

/* Quick Details Panel */
#quick-details-pane {
    height: 6;
    background: #0f172a;
    border-top: solid #1e293b;
    padding: 0 1;
    layout: horizontal;
}

#quick-details-left {
    width: 1fr;
}

#quick-details-right {
    width: 1fr;
}

.detail-line {
    color: #cbd5e1;
    height: 1;
}

/* Action Footer */
#action-footer {
    dock: bottom;
    height: 1;
    background: #0f172a;
    color: #94a3b8;
    border-top: solid #1e293b;
    padding: 0 1;
}

/* Modals */
ModalScreen {
    align: center middle;
    background: rgba(9, 13, 22, 0.88);
}

.modal-dialog {
    width: 88%;
    height: 85%;
    background: #0f172a;
    border: thick #38bdf8;
    padding: 1 2;
}

.modal-title {
    text-style: bold;
    color: #38bdf8;
    border-bottom: solid #1e293b;
    padding-bottom: 0;
    margin-bottom: 1;
}

/* Log Modal */
#log-text-area {
    height: 1fr;
    background: #090d16;
    border: solid #1e293b;
    color: #f1f5f9;
    padding: 0 1;
}

#log-controls {
    height: 3;
    layout: horizontal;
    margin-top: 1;
}

.log-btn {
    margin-right: 1;
    min-width: 12;
}

/* Confirm Dialog */
.confirm-dialog {
    width: 58;
    height: 14;
    background: #0f172a;
    border: thick #ef4444;
    padding: 1 2;
    align: center middle;
}

#confirm-message {
    margin-top: 1;
    margin-bottom: 1;
    color: #e2e8f0;
    text-align: center;
}

#confirm-buttons {
    layout: horizontal;
    align: center middle;
    height: 3;
}

.btn-danger {
    background: #dc2626;
    color: #ffffff;
    margin-right: 2;
}

.btn-secondary {
    background: #334155;
    color: #ffffff;
}

/* Help Modal */
.help-dialog {
    width: 76;
    height: 23;
    background: #0f172a;
    border: thick #38bdf8;
    padding: 1 2;
}

#help-table {
    height: 1fr;
    background: #090d16;
    border: solid #1e293b;
}
